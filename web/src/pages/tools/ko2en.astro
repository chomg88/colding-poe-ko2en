---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import "../../styles/ko2en.css";
import { readdirSync } from "node:fs";

/* 사전 파일명에는 내용 해시가 박혀 있다(영구 캐시용).
   빌드 시점에 public/data/ 를 훑어 실제 파일명을 찾아 data 속성으로 넘긴다. */
const files = readdirSync(new URL("../../../public/data", import.meta.url));
const pick = (prefix) => {
  const f = files.find((x) => x.startsWith(prefix) && x.endsWith(".json.gz"));
  if (!f) throw new Error(`public/data/ 에 ${prefix}*.json.gz 가 없습니다. tools/build_data.py 를 먼저 실행하세요.`);
  return `/data/${f}`;
};
---
<Base
  title="아이템 역번역기"
  description="한글 클라이언트에서 복사한 Path of Exile 아이템 텍스트를 영문 Path of Building 이 읽는 형태로 되돌립니다. 브라우저 안에서만 동작합니다."
>
  <section style="padding-block:28px 18px">
    <h1>아이템 역번역기</h1>
    <p style="margin:8px 0 0; color:var(--muted); max-width:62ch">
      게임에서 아이템을 <code>Ctrl+C</code> 한 뒤 왼쪽에 붙여넣으세요.
      영문 Path of Building 의 아이템 입력칸에 그대로 넣을 수 있는 형태로 바꿔 줍니다.
      번역은 전부 브라우저 안에서 이루어지며 서버로는 아무것도 보내지 않습니다.
    </p>
  </section>

  <div class="tool" data-tool data-core={pick("dict-core-")} data-names={pick("dict-names-")}>
    <div class="veil" data-veil>
      <div class="bar"><i></i></div>
      <div data-note>번역 사전 내려받는 중 · 3.7MB</div>
    </div>

    <section class="pane" data-app hidden>
      <div class="head">
        <span class="lbl">한글 원문</span>
        <div class="grow">
          <button class="btn" type="button" data-sample>예시</button>
          <button class="btn" type="button" data-clear>비우기</button>
        </div>
      </div>
      <textarea data-in spellcheck="false" placeholder="게임에서 아이템을 Ctrl+C 한 뒤 여기에 붙여넣으세요."></textarea>
    </section>

    <section class="pane" data-app hidden>
      <div class="head">
        <span class="lbl">영문 결과</span>
        <span class="tally" data-tally></span>
        <div class="grow">
          <button class="btn primary" type="button" data-copy>복사</button>
        </div>
      </div>
      <div data-out></div>
    </section>
  </div>

  <div class="legend">
    <span><i style="background:var(--s-ok)"></i>옵션 매칭</span>
    <span><i style="background:var(--s-frame)"></i>구조 · 속성</span>
    <span><i style="background:var(--s-base)"></i>베이스타입만 복원</span>
    <span><i style="background:var(--s-amb)"></i>후보 여럿 — 눌러서 교체</span>
    <span><i style="background:var(--s-miss)"></i>사전에 없음 — 원문 유지</span>
  </div>

  <AdSlot slot="" />
</Base>

<script>
  import { mount } from "../../lib/ko2en/ui.js";
  const el = document.querySelector("[data-tool]");
  mount(el, { core: el.dataset.core, names: el.dataset.names });
</script>
