---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import "../../styles/tablet.css";
import "../../styles/waystone.css";
import { WAYSTONE } from "../../site.js";

/* 서판과 달리 빌드에 들어가는 카탈로그가 없다. 무엇을 물어봤는지(축·구간)까지 수집기가
   시세 파일에 실어 보내므로, 페이지는 주소만 넘기면 된다(DEPLOY.md 「경로석 시세」). */

const description =
  "Path of Exile 2 경로석 시세. 15·16등급 경로석이 몬스터 효율·희귀도·무리 규모 같은 속성 수치별로 얼마에 팔리는지 봅니다.";
const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "POE2 경로석 시세",
  url: new URL("/tools/waystone/", Astro.site).href,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  inLanguage: "ko",
  description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "KRW" },
};
---
<Base title="POE2 경로석 시세" description={description} jsonld={jsonld}>
  <section class="lede">
    <h1>POE2 경로석 시세</h1>
    <p>
      경로석은 붙은 옵션이 아니라 <strong>아이템에 찍힌 속성 수치</strong>로 값이 갈립니다.
      15·16등급을 속성별·구간별로 모았습니다. 속성 두 개가 같이 붙어 값이 뛰는 자리는 아래
      <strong>조합 표</strong>에 따로 있습니다. <strong>즉시구입 매물</strong> 기준이고, 가장 싼 10건의 중앙값입니다.
    </p>
  </section>

  <div
    class="tb"
    data-waystone
    data-prices={WAYSTONE.prices}
    data-warn={WAYSTONE.warnHours}
    data-bad={WAYSTONE.badHours}
  >
    <div class="tb-veil" data-veil>
      <div class="bar"><i></i></div>
      <div data-veil-note>시세 불러오는 중</div>
    </div>

    <div data-app hidden>
      <p class="tb-alert" data-alert hidden></p>
      <div class="tb-status" data-status></div>
      <div class="tb-bar">
        <div class="seg" data-seg="cur" aria-label="화폐 단위">
          <button type="button" data-v="ch">카오스</button>
          <button type="button" data-v="ex">엑잘</button>
          <button type="button" data-v="div">디바인</button>
        </div>
      </div>
      <div class="tb-scroll">
        <table class="tb-table">
          <thead data-head></thead>
          <tbody data-rows></tbody>
        </table>
      </div>

      <div data-combo hidden>
        <h2 class="ws-sub">속성 두 개가 같이 붙은 것</h2>
        <p class="ws-note">
          두 속성이 <strong>같이</strong> 그 구간 이상인 매물만 골라 본 값입니다.
          낮은 구간끼리만 붙기 때문에 여기 없는 조합은 매물이 거의 없습니다.
        </p>
        <div class="tb-scroll">
          <table class="tb-table">
            <thead data-head2></thead>
            <tbody data-rows2></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <AdSlot slot="" />

  <section class="guide">
    <h2>이 표를 읽는 법</h2>
    <dl class="faq">
      <dt>속성이 무엇인가요</dt>
      <dd>
        경로석에 찍힌 <strong>아이템 희귀도 +28%</strong>, <strong>무리 규모 +25%</strong> 같은 수치입니다.
        경로석의 옵션 줄은 전부 몬스터를 세게 만드는 위험 옵션이라 값의 근거가 되지 못합니다.
        사는 사람이 보는 것은 속성 수치입니다.
      </dd>

      <dt>구간은 '이 값 이상' 입니다</dt>
      <dd>
        "몬스터 효율 70%+" 는 효율이 70% 이상인 매물만 골라 본 값입니다. 그 속성이 아예 없는
        경로석은 이 검색에서 빠집니다. 숫자를 누르면 그 검색이 거래소에서 열립니다.
      </dd>

      <dt>등급마다 구간이 다릅니다</dt>
      <dd>
        같은 속성이라도 15등급이 16등급보다 높게 굴러갑니다. 아이템 희귀도 90%, 무리 규모 55%,
        출현 확률 160% 는 15등급에만 있습니다. 그 등급에 없는 구간은 흐린 <span class="ws-off">-</span> 로 둡니다.
      </dd>

      <dt>속성 두 개가 같이 높은 경로석은요</dt>
      <dd>
        높은 값에서는 거의 없습니다. 효율·몬스터 희귀도·아이템 희귀도·무리 규모는 서로 붙지
        않아서, 16등급 효율 50%+ 이면서 몬스터 희귀도 50%+ 인 매물은 0건입니다. 그래서 경로석
        값은 대체로 <strong>가장 높이 굴러간 속성 하나</strong>로 정해집니다.
      </dd>

      <dt>그러면 조합 표는 무엇인가요</dt>
      <dd>
        <strong>낮은 구간끼리는 붙습니다.</strong> 그중 값이 실제로 오르는 자리만 따로 모은 표입니다 —
        16등급 효율 30%+ 이면서 몬스터 희귀도 50%+ 인 경로석은 효율 30%+ 짜리 하나보다
        네 배 가까이 비쌉니다. 값이 오르는 것은 <strong>효율이 낀 조합</strong>이 대부분이고,
        효율이 없는 조합(몬스터 희귀도 30%+ &amp; 아이템 희귀도 40%+ 따위)은 비싼 쪽 속성
        하나짜리와 값이 같아 표에 두지 않았습니다.
      </dd>

      <dt>출현 확률은 왜 조합에 없나요</dt>
      <dd>
        출현 확률은 다른 속성과 제일 잘 붙습니다 — 품질 굴림과 따로 놀기 때문입니다. 대신
        실제로 값이 붙는 것은 <strong>높은 출현 확률 단독</strong>이라, 위 속성 표에서 구간별로 봅니다.
      </dd>

      <dt>줄 끝의 '정규식' 은 무엇인가요</dt>
      <dd>
        <strong>게임 창고 검색창</strong>에 붙여 넣을 검색식입니다. 등급 버튼을 누르면 그 줄의
        조건이 클립보드에 들어갑니다. 예를 들어 조합 표에서 16등급 <strong>몬스터 효율 50%+ &amp;
        몬스터 희귀도 30%+</strong> 의 <span class="ws-rx">16</span> 을 누르면
        <code>"16등급" "율:.*([5-9].|[1-9]..)%" "터.*도:.*([3-9].|[1-9]..)%"</code> 가 복사됩니다.
        그대로 창고 검색창에 넣으면 그 조건을 만족하는 경로석만 남습니다.
      </dd>

      <dt>정규식이 왜 저렇게 생겼나요</dt>
      <dd>
        정규식에는 '이 수보다 크다' 가 없어서 자릿수로 펼쳐야 합니다. <strong>50 이상</strong>은
        "십의 자리가 5~9 인 두 자리" 이거나 "세 자리" 라서 <code>([5-9].|[1-9]..)</code> 가 됩니다.
        앞의 <code>율:</code>, <code>터.*도:</code> 는 경로석에 찍힌 줄(<code>몬스터 효율: +54%</code>)을
        알아보는 최소한의 글자입니다 — 검색창 한도가 250자라 짧게 끊습니다.
        만드는 방식은 <a href="https://poeregexkr.web.app/poe2/map" target="_blank" rel="noopener">
        poeregexkr</a> 의 것을 따랐습니다.
      </dd>

      <dt>그 등급 버튼이 흐리면</dt>
      <dd>
        그 등급에는 두지 않은 조건입니다. 값 칸의 흐린 <span class="ws-off">-</span> 와 같은
        뜻이라, 눌러도 복사할 것이 없습니다.
      </dd>

      <dt>매물 수가 10,000 이면</dt>
      <dd>거래소가 그쯤에서 세다 맙니다. 실제로는 더 많습니다 — 흔한 구간이라는 뜻입니다.</dd>

      <dt>값은 언제 바뀌나요</dt>
      <dd>
        수집기가 거래소 요청 한도 안에서 구간을 하나씩 돌며 모읍니다. 서판 시세와 번갈아 돌기
        때문에 같은 구간은 몇 시간마다 다시 봅니다. 수집이 멈추면 표 위에 경고가 뜹니다.
      </dd>
    </dl>
  </section>

  <AdSlot slot="" />
</Base>

<script>
  import { mount } from "../../lib/waystone/ui.js";
  mount(document.querySelector("[data-waystone]"));
</script>
