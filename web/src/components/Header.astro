---
import { SITE, TABS } from "../site.js";
const path = Astro.url.pathname;
/* 현재 탭 판정: "/" 는 정확히 일치할 때만, 나머지는 접두 일치 */
const active = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/"><span class="mk"></span>{SITE.name}</a>
    <nav class="tabs" aria-label="주요 메뉴">
      {TABS.map((t) => (
        <a href={t.href} aria-current={active(t.href) ? "page" : undefined}>{t.label}</a>
      ))}
    </nav>
  </div>
</header>
