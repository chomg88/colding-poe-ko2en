---
import { SITE } from "../site.js";
const path = Astro.url.pathname;
const on = (p) => (path === p || (p !== "/" && path.startsWith(p)) ? "page" : undefined);
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/"><span class="dot"></span>{SITE.name}</a>
    <nav class="site-nav">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>도구</a>
      <a href="/guides/" aria-current={on("/guides")}>가이드</a>
    </nav>
  </div>
</header>
